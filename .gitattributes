# =============================================================================
# GitHub Linguist overrides — make EVERY recognized file count toward the
# repository language statistics, including types Linguist hides by default
# (prose like Markdown/Text, data formats, documentation, vendored, generated).
#
# Linguist docs: https://github.com/github-linguist/linguist/blob/master/docs/overrides.md
# =============================================================================

# --- Global catch-all: detect & count everything Linguist can identify --------
# `linguist-detectable` flips on the normally-off categories (prose, data, …).
# The three `=false` lines stop Linguist auto-excluding files it guesses are
# documentation / third-party / machine-generated.
*                 linguist-detectable=true
*                 linguist-documentation=false
*                 linguist-vendored=false
*                 linguist-generated=false

# --- Prose types (OFF by default) — force them into the language bar ----------
*.md              linguist-detectable=true
*.markdown        linguist-detectable=true
*.mdx             linguist-detectable=true
*.txt             linguist-detectable=true linguist-language=Text
*.text            linguist-detectable=true linguist-language=Text
*.rst             linguist-detectable=true
*.adoc            linguist-detectable=true
*.asciidoc        linguist-detectable=true
*.org             linguist-detectable=true
*.tex             linguist-detectable=true
*.rtf             linguist-detectable=true linguist-language=Text
LICENSE           linguist-detectable=true linguist-language=Text
README            linguist-detectable=true linguist-language=Text

# --- Data / config types (OFF by default) -------------------------------------
*.json            linguist-detectable=true
*.jsonl           linguist-detectable=true
*.geojson         linguist-detectable=true
*.json5           linguist-detectable=true
*.yaml            linguist-detectable=true
*.yml             linguist-detectable=true
*.toml            linguist-detectable=true
*.ini             linguist-detectable=true
*.cfg             linguist-detectable=true
*.csv             linguist-detectable=true
